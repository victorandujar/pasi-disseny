---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';
interface Props { title: string; lang: Lang; alternates: Record<Lang, string> }
const { title, lang, alternates } = Astro.props;
const nota = lang === 'ca' ? 'Text provisional de la proposta, pendent de revisió per l’empresa.' : 'Texto provisional de la propuesta, pendiente de revisión por la empresa.';
---
<Base title={`${title} · Pasi Disseny`} description={`${title} · Pasi Disseny`} lang={lang} alternates={alternates}>
  <Header lang={lang} alternates={alternates} />
  <main id="contenido" class="mx-auto max-w-3xl px-4 py-20 sm:px-8 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_p]:mt-4 [&_p]:text-ink-2">
    <h1 class="titol text-6xl">{title}</h1>
    <p class="bg-paper-2 p-4 text-sm">{nota}</p>
    <slot />
  </main>
  <Footer lang={lang} />
</Base>
