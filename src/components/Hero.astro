---
import { Image } from 'astro:assets';
import foto from '../assets/proyectos/proyecto-02.jpg';
import { empresa, mailUrl, telUrl } from '../data/empresa';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang];
const anys = new Date().getFullYear() - empresa.since;
---
<section aria-labelledby="hero-t" class="relative overflow-hidden">
  <div class="mx-auto grid max-w-[90rem] items-end gap-10 px-4 pb-16 pt-12 sm:px-8 lg:grid-cols-12 lg:pb-24 lg:pt-16">
    <div class="relative z-10 lg:col-span-6">
      <p class="label flex items-center gap-3 text-ink-2" data-reveal><span class="h-3 w-3 shrink-0 bg-groc" aria-hidden="true"></span>{tx.hero.eyebrow}</p>
      <h1 id="hero-t" class="titol mt-6 text-[clamp(3.1rem,7.6vw,7rem)]" data-reveal style="--i:1">
        {tx.hero.t1} <span class="subratllat">{tx.hero.marca}</span> {tx.hero.t2}
      </h1>
      <p class="mt-7 max-w-lg text-lg text-ink-2" data-reveal style="--i:2">{tx.hero.text(empresa.since)}</p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--i:3">
        <a href={mailUrl(tx.contacto.asunto)} class="btn btn-groc">{tx.hero.cta}</a>
        <a href={telUrl} class="btn btn-line tabular-nums">{empresa.phone.display}</a>
      </div>
    </div>
    <div class="relative lg:col-span-6" data-reveal style="--i:2">
      <div class="esglao absolute -left-6 -top-6 hidden h-40 w-56 bg-groc lg:block" aria-hidden="true"></div>
      <figure class="relative">
        <Image src={foto} alt={tx.hero.alt} widths={[480, 800, 1024]} sizes="(min-width: 1024px) 45vw, 92vw" class="aspect-[4/3] w-full object-cover" loading="eager" fetchpriority="high" />
        <figcaption class="absolute bottom-0 right-0 bg-ink px-5 py-4 text-paper">
          <span class="titol block text-4xl text-groc">+{anys}</span>
          <span class="label text-[0.65rem] text-paper/80">{tx.hero.anys}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .subratllat { background: linear-gradient(transparent 56%, var(--color-groc) 56%, var(--color-groc) 90%, transparent 90%); -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .esglao { clip-path: polygon(0 0, 100% 0, 100% 30%, 78% 30%, 78% 55%, 58% 55%, 58% 78%, 35% 78%, 35% 100%, 0 100%); }
</style>
