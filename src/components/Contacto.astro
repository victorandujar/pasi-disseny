---
import { empresa, mailUrl, telUrl } from '../data/empresa';
import { ui, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = ui[lang];
---
<section id="contacto" aria-labelledby="cont-t" class="scroll-mt-20 bg-groc">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-4 py-20 sm:px-8 sm:py-28 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-6">
      <p class="label" data-reveal>{tx.contacto.label}</p>
      <h2 id="cont-t" class="titol mt-4 text-[clamp(2.8rem,6.5vw,5.8rem)]" data-reveal style="--i:1">{tx.contacto.title}</h2>
      <p class="mt-6 max-w-md text-lg" data-reveal style="--i:2">{tx.contacto.text}</p>
      <address class="mt-10 not-italic text-xl" data-reveal style="--i:3">
        {empresa.street}<br />{empresa.postalCode} {empresa.city}
        <a href={empresa.maps} target="_blank" rel="noopener" class="mt-3 block w-fit border-b-2 border-ink pb-1 font-semibold">{tx.contacto.llegar} ↗</a>
      </address>
    </div>
    <div class="grid min-w-0 content-start gap-3 lg:col-span-5 lg:col-start-8">
      <a href={mailUrl(tx.contacto.asunto)} class="group flex min-w-0 items-center justify-between gap-4 bg-ink p-7 text-paper" data-reveal>
        <span class="min-w-0"><span class="label block text-paper/60">{tx.contacto.email}</span><span class="mt-1 block truncate text-xl font-semibold">{empresa.email}</span></span>
        <span aria-hidden="true" class="text-3xl transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a href={telUrl} class="group flex items-center justify-between gap-4 bg-paper p-7" data-reveal style="--i:1">
        <span><span class="label block text-ink-2">{tx.contacto.tel}</span><span class="titol mt-1 block text-4xl tabular-nums">{empresa.phone.display}</span></span>
        <span aria-hidden="true" class="text-3xl transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</section>
