---
import { Image } from 'astro:assets';
import { proyectos } from '../data/empresa';
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/proyectos/*.jpg', { eager: true });
const foto = (n: number) => fotos[`../assets/proyectos/proyecto-0${n}.jpg`]!.default;
const grups = [
  { id: 'Comercio', titol: 'Comercios y librerías', text: 'Estanterías, mesas expositoras y mostradores fabricados y montados a medida del local.' },
  { id: 'Stand', titol: 'Stands de feria', text: 'Vitrinas, mostradores y paneles, con la luz integrada en el mueble.' },
];
---
<section id="proyectos" aria-labelledby="proy-t" class="scroll-mt-20 bg-ink text-paper">
  <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-8 sm:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="label text-groc" data-reveal>Proyectos</p>
        <h2 id="proy-t" class="titol mt-4 text-[clamp(2.6rem,6vw,5.2rem)]" data-reveal style="--i:1">Hecho en el taller, montado donde haga falta.</h2>
      </div>
      <p class="text-lg text-paper/70 lg:col-span-4 lg:col-start-9" data-reveal style="--i:2">Algunos de los espacios que hemos fabricado y montado. Pulsa una foto para verla grande.</p>
    </div>

    {grups.map((g) => {
      const items = proyectos.filter((p) => p.tipo === g.id);
      return (
        <div class="mt-16">
          <div class="flex flex-wrap items-baseline justify-between gap-4 border-t border-paper/15 pt-6" data-reveal>
            <h3 class="titol text-3xl">{g.titol}</h3>
            <p class="max-w-md text-paper/60">{g.text}</p>
          </div>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {items.map((p, i) => (
              <li class={i === 0 ? 'sm:col-span-2 sm:row-span-2' : i === 3 ? 'sm:col-span-2' : ''} data-reveal style={`--i:${i}`}>
                <button type="button" class="group relative block h-full w-full overflow-hidden text-left" data-obre={p.n} aria-label={`Ver grande: ${p.t}. ${p.d}`}>
                  <Image src={foto(p.n)} alt={`${p.t}. ${p.d}`} widths={[480, 800, 1024]} sizes={i === 0 || i === 3 ? '(min-width: 1024px) 45vw, 92vw' : '(min-width: 1024px) 22vw, 92vw'} class="h-full min-h-48 w-full object-cover transition-transform duration-700 group-hover:scale-[1.05]" loading="lazy" />
                  <span class="absolute inset-x-0 bottom-0 translate-y-full bg-groc px-4 py-3 text-sm font-semibold text-ink transition-transform duration-300 group-hover:translate-y-0 group-focus-visible:translate-y-0">{p.d}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>

  <dialog class="m-auto max-h-[92dvh] w-[min(96vw,72rem)] bg-transparent p-0 text-paper backdrop:bg-black/85" data-visor>
    <form method="dialog" class="flex justify-end"><button class="label px-2 py-3 text-paper">Cerrar ✕</button></form>
    {proyectos.map((p) => (
      <figure data-foto={p.n} hidden>
        <Image src={foto(p.n)} alt={`${p.t}. ${p.d}`} widths={[1024]} sizes="96vw" class="max-h-[80dvh] w-full object-contain" loading="lazy" />
        <figcaption class="mt-3"><strong>{p.t}.</strong> <span class="text-paper/70">{p.d}</span></figcaption>
      </figure>
    ))}
  </dialog>
</section>

<script>
  const visor = document.querySelector<HTMLDialogElement>('[data-visor]');
  document.querySelectorAll<HTMLButtonElement>('[data-obre]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!visor) return;
      visor.querySelectorAll<HTMLElement>('[data-foto]').forEach((f) => { f.hidden = f.dataset.foto !== b.dataset.obre; });
      visor.showModal();
    }),
  );
  visor?.addEventListener('click', (e) => { if (e.target === visor) visor.close(); });
</script>
