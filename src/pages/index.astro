---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Proyectos from '../components/Proyectos.astro';
import Montaje from '../components/Montaje.astro';
import Clientes from '../components/Clientes.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Schema from '../components/Schema.astro';
---
<Base
  title="Pasi Disseny · Ebanistería y carpintería a medida en Badalona"
  description="Ebanistería y carpintería a medida desde 1998 en Badalona: mobiliario para comercios, librerías, stands de feria, particulares, decoradores y arquitectos. Tel. 933 84 73 02."
>
  <Schema slot="head" />
  <Header />
  <main id="contenido">
    <Hero />
    <Proyectos />
    <Montaje />
    <Clientes />
    <Contacto />
  </main>
  <Footer />
  <MobileBar />
</Base>
